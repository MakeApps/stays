# Copy to .env.local for development. Never commit a real .env.

ENV=development
DEBUG=true
APP_VERSION=0.1.0

# ---- database ----
# XAMPP's MariaDB 10.4 by default. Production runs MySQL 8.0, so the schema is
# kept inside the common subset of both and CI runs against each.
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/localshouts_stays?charset=utf8mb4
SQL_ECHO=false
SLOW_QUERY_MS=200

# ---- security ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to boot unless both are set explicitly.
SECRET_KEY=
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000

# ---- bootstrap admin (no public signup) ----
# Leave ADMIN_PASSWORD blank and `flask create-admin` prints a generated one.
ADMIN_EMAIL=info@localshouts.com
ADMIN_PASSWORD=
ADMIN_NAME=Pim Suwannarat

# ---- storage ----
# local  = signed URLs off local disk, no credentials needed
# s3     = any S3-compatible bucket (AWS, R2, MinIO, B2) — untested until keys exist
STORAGE_BACKEND=local
UPLOAD_MAX_BYTES=10485760

S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- reports ----
# WeasyPrint needs GTK, which is impractical on Windows. PDF endpoints return
# 501 until the container phase supplies the runtime and Thai fonts.
REPORTS_PDF_ENGINE=none

APP_TIMEZONE=Asia/Bangkok
